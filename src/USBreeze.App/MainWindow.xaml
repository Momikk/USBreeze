<Window x:Class="USBreeze.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:USBreeze.App" Title="{Binding [Title], Source={x:Static local:Texts.Current}}" Width="850" SizeToContent="Height" MinWidth="730" MinHeight="580" Background="#F5F7FB" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft YaHei UI" SizeChanged="WindowSizeChanged" Loaded="OnLoaded" Closing="OnClosing" Icon="Assets/USBreeze.ico">
 <Window.Resources>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="White"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#EDF3FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#E8F0FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="White" Padding="2,4"><Grid><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" Margin="0,0,24,0" VerticalAlignment="Center"/><TextBlock x:Name="Placeholder" Text="{Binding [NoDevice], Source={x:Static local:Texts.Current}}" Foreground="#63748B" FontSize="14" Visibility="Collapsed" Margin="0,0,24,0"/><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="#63748B" Margin="4,0"/></Grid></Border><ControlTemplate.Triggers><DataTrigger Binding="{Binding HasItems, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="False"><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></DataTrigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#2563EB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="White" BorderBrush="#DFE6F0" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" Padding="3"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>

  <Style x:Key="Mode" TargetType="RadioButton"><Setter Property="Padding" Value="17,9"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#63748B"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="White"/><Setter Property="Foreground" Value="#192A40"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Margin="34,26,34,26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><Image Source="Assets/USBreeze.png" Width="40" Height="40" Margin="0,0,11,0"/><TextBlock Text="USBreeze" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <TextBlock Grid.Column="1" Text="{Binding [Headline], Source={x:Static local:Texts.Current}}" FontSize="15" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="22,0,12,0" TextWrapping="Wrap"/>
   <Button Grid.Column="2" x:Name="LanguageButton" Click="LanguageClick" Background="Transparent" Padding="10,8" ToolTip="Language / 语言" AutomationProperties.Name="Language / 语言"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding [LanguageButton], Source={x:Static local:Texts.Current}}"/><TextBlock Text="⌄" Margin="8,0,0,0"/></StackPanel><Button.ContextMenu><ContextMenu x:Name="LanguageMenu"><MenuItem x:Name="SystemLanguage" Header="{Binding [FollowSystem], Source={x:Static local:Texts.Current}}" Tag="system" IsCheckable="True" Click="LanguageSelected"/><Separator/><MenuItem x:Name="ChineseLanguage" Header="简体中文" Tag="zh-Hans" IsCheckable="True" Click="LanguageSelected"/><MenuItem x:Name="EnglishLanguage" Header="English" Tag="en" IsCheckable="True" Click="LanguageSelected"/></ContextMenu></Button.ContextMenu></Button>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Width="50" Height="50" CornerRadius="12" Background="#EDF2F9" Margin="0,0,14,0"><TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#2563EB" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><ComboBox x:Name="DevicePicker" FontSize="16" MinHeight="32" DisplayMemberPath="DisplayName" SelectionChanged="DeviceChanged" AutomationProperties.Name="{Binding [Device], Source={x:Static local:Texts.Current}}"/><TextBlock x:Name="DeviceInfo" FontSize="12" Foreground="{StaticResource Muted}" Margin="2,6,0,0" TextWrapping="Wrap"/></StackPanel>
   <Border Grid.Column="2" x:Name="ConnectedBadge" Background="#E8F5EF" CornerRadius="14" Padding="10,6" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding [Connected], Source={x:Static local:Texts.Current}}" FontSize="11" Foreground="#087C68"/></Border>
   <Button Grid.Column="3" x:Name="RefreshButton" Click="RefreshClick" FontSize="15" Background="Transparent" Padding="10,10" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{Binding [Refresh], Source={x:Static local:Texts.Current}}" AutomationProperties.Name="{Binding [Refresh], Source={x:Static local:Texts.Current}}"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15"/></Button>
  </Grid></Border>
  <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="↗" Foreground="#2563EB" Margin="0,0,6,0"/><TextBlock Text="{Binding [Write], Source={x:Static local:Texts.Current}}" Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,13,0,0"><local:AnimatedSpeed x:Name="WriteValue" Text="—" FontSize="48" FontWeight="SemiBold"/><TextBlock Text="MB/s" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Bottom" Margin="8,0,0,10"/></StackPanel><local:SpeedChart x:Name="WriteChart" Height="32" Margin="0,10,0,0" AutomationProperties.Name="{Binding [Write], Source={x:Static local:Texts.Current}}"/><TextBlock x:Name="WriteTime" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="↙" Foreground="#087C68" Margin="0,0,6,0"/><TextBlock Text="{Binding [Read], Source={x:Static local:Texts.Current}}" Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,13,0,0"><local:AnimatedSpeed x:Name="ReadValue" Text="—" FontSize="48" FontWeight="SemiBold"/><TextBlock Text="MB/s" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Bottom" Margin="8,0,0,10"/></StackPanel><local:SpeedChart x:Name="ReadChart" Height="32" Margin="0,10,0,0" AutomationProperties.Name="{Binding [Read], Source={x:Static local:Texts.Current}}"/><TextBlock x:Name="ReadTime" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,26,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#EAF0F8" CornerRadius="10" Padding="4" HorizontalAlignment="Left" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><RadioButton x:Name="QuickMode" Style="{StaticResource Mode}" Content="{Binding [Quick], Source={x:Static local:Texts.Current}}" GroupName="Mode" Tag="0" Checked="ModeChanged"/><RadioButton x:Name="LargeFileMode" Style="{StaticResource Mode}" Content="{Binding [LargeFile], Source={x:Static local:Texts.Current}}" GroupName="Mode" Tag="1" Checked="ModeChanged"/><RadioButton x:Name="SmallFilesMode" Style="{StaticResource Mode}" Content="{Binding [SmallFiles], Source={x:Static local:Texts.Current}}" GroupName="Mode" Tag="2" Checked="ModeChanged"/></StackPanel></Border><Button Grid.Column="1" x:Name="StartButton" Click="StartClick" Background="#2563EB" Foreground="White" Padding="24,14" IsEnabled="False" MinWidth="150"><StackPanel Orientation="Horizontal"><TextBlock x:Name="StartGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock x:Name="StartLabel" Foreground="White" FontWeight="SemiBold"/></StackPanel></Button></Grid>
   <ProgressBar x:Name="Progress" Height="5" Maximum="1" Foreground="#2563EB" Background="#E6EDF6" BorderThickness="0" Margin="0,19,0,10" AutomationProperties.Name="{Binding [Title], Source={x:Static local:Texts.Current}}"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Grid.Column="1" x:Name="ModeInfo" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0"/></Grid>
   <TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="#AB3932" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
  </StackPanel>
  <StackPanel Grid.Row="5" Margin="0,22,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Expander x:Name="HistoryExpander" Expanded="HistoryToggled" Collapsed="HistoryToggled" Header="{Binding [Recent], Source={x:Static local:Texts.Current}}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,12,0"><StackPanel Margin="0,10,0,0"><TextBlock x:Name="HistoryEmpty" Text="{Binding [NoHistory], Source={x:Static local:Texts.Current}}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/><ItemsControl x:Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="0,9" BorderBrush="#E1E8F1" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button x:Name="ExportButton" Content="{Binding [Export], Source={x:Static local:Texts.Current}}" Click="ExportClick" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,7" FontSize="12" IsEnabled="False"/></StackPanel></Expander><Button Grid.Column="1" Click="HelpClick" Content="{Binding [Help], Source={x:Static local:Texts.Current}}" Foreground="#2563EB" Background="Transparent" FontSize="12" Padding="4,2" VerticalAlignment="Top"/></Grid></StackPanel>
  <StackPanel Grid.Row="6" Margin="0,22,0,0"><Border BorderBrush="#E1E8F1" BorderThickness="0,1,0,0" Padding="0,13,0,0"><TextBlock Text="{Binding [FooterSafety], Source={x:Static local:Texts.Current}}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></Border><TextBlock Text="{Binding [FooterScope], Source={x:Static local:Texts.Current}}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/><Button Content="Momikk · GitHub ↗" Click="HomepageClick" ToolTip="https://github.com/Momikk" Foreground="#2563EB" Background="Transparent" FontSize="11" Padding="0,4" Margin="0,6,0,0" HorizontalAlignment="Left"/></StackPanel>
 </Grid></ScrollViewer>
</Window>
