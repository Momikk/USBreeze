<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>USBreeze</AssemblyName>
    <Version>0.2.1</Version>
    <Authors>Momikk</Authors>
    <Company>Momikk · https://github.com/Momikk</Company>
    <Copyright>Copyright © Momikk · https://github.com/Momikk</Copyright>
    <PackageProjectUrl>https://github.com/Momikk</PackageProjectUrl>
    <ApplicationIcon>Assets/USBreeze.ico</ApplicationIcon>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/USBreeze.ico" />
    <Resource Include="Assets/USBreeze.png" />
    <ProjectReference Include="../USBreeze.Core/USBreeze.Core.csproj" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="USBreeze.LICENSE" />
    <EmbeddedResource Include="../../licenses/DOTNET-LICENSE.txt" LogicalName="USBreeze.DOTNET-LICENSE" />
    <EmbeddedResource Include="../../licenses/DOTNET-THIRD-PARTY-NOTICES.txt" LogicalName="USBreeze.DOTNET-NOTICES" />
  </ItemGroup>
</Project>
